# Copy this file to .env and fill in your local values.
# Keep secrets out of version control.

# PostgreSQL connection string used by Pyramid.
DATABASE_URL=postgresql+psycopg2://conduit_dev@localhost/conduit_dev

# Secret used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-secret

# Validate that the database has the latest migrations.
CHECK_DB_MIGRATED=true

# Enable OpenAPI endpoint validation.
ENABLE_ENDPOINT_VALIDATION=false
